{
  "name": "@multiapi/arco-cloud-client",
  "version": "0.1.6",
  "description": "Arco Cloud runner protocol client: start/logs/finish API, log batching and the Arco deploy session",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multi-api/arco-deploy-action.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/multi-api/arco-deploy-action/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/multi-api/arco-deploy-action/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
